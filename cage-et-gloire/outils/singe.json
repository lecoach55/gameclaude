{
 "jeu": "cage-et-gloire",
 "fichier": "/home/claude/cg.html",
 "stockage": {
  "cg-qual": "0"
 },
 "entree": [
  "#bNouv",
  {
   "attendre": 300
  },
  "#bGo",
  {
   "attendre": 600
  }
 ],
 "pret": "typeof G!=='undefined' && G && G.sem!=null",
 "eviter": [
  "mBanc",
  "mBug",
  "Mesurer la fluidité",
  "Signaler",
  "Nouvelle partie",
  "Effacer"
 ],
 "selecteur": ".btn,[data-v],[data-i],[data-f]",
 "priorites": [
  {
   "motif": "semaine|résultat|on y va|voir le combat|suivant|cage",
   "poids": 0.35
  }
 ],
 "etat": "'semaine '+G.sem",
 "invariants": "(()=>{const b=[];if(typeof G==='undefined'||!G)return b;if(!isFinite(G.argent))b.push('argent '+G.argent);return b;})()",
 "pause": [
  60,
  600
 ],
 "visiter": [
  {
   "nom": "combat 3D",
   "si": "!!document.querySelector('#arene:not(.cache), #combat:not(.cache)')",
   "aller": [
    {
     "js": "for(let w=0;w<40;w++){if(G.aJouer&&G.aJouer.length)break;Moteur.avancer();if(G.popup)Moteur.choisir(0);for(const o of [...G.offres])if(o.type==='combat')Moteur.accepterCombat(o.id);}rendre();if(G.aJouer.length)preCombat(G.aJouer[0]);"
    },
    {
     "attendre": 300
    },
    "#bVoir"
   ],
   "apres": 30,
   "encore": true
  }
 ]
}