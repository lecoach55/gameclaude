{
 "jeu": "couronnes-et-lignees",
 "_note": "Studio de captures commun (outils-communs/captures.py), mêmes vues que outils/mesure/captures.py. 2D : python3 outils-communs/captures.py couronnes-et-lignees/outils/vues.json /tmp/cl --comparer couronnes-et-lignees/references ; 3D : vues3d.json. Sans références : --avant HEAD.",
 "fichier": "couronnes-et-lignees/jeu/index.html",
 "construire": "cd couronnes-et-lignees/jeu && python3 build.py",
 "appareils": {
  "telephone": {
   "largeur": 390,
   "hauteur": 844,
   "dpr": 2,
   "mouvement_reduit": true
  }
 },
 "stockage": {
  "cl_3d": "0",
  "cl_guide": "1",
  "cl_sound": "{\"sfx\":false,\"music\":false}"
 },
 "graine": 1234,
 "preparation": "reelle",
 "pret": "typeof startTest==='function'",
 "pret_ms": 600,
 "entree": "startTest();for(let i=0;i<8;i++){D.playTurn(S,'attendre');if(S.event)D.resolveEvent(S,0);}S.event=null;D.autoCouncil(S);render();",
 "masquer": [
  "div[style*=\"9999\"]"
 ],
 "avant_chaque": "closeM()",
 "pause_ms": 150,
 "images": 16,
 "pas": 50,
 "vues": [
  {
   "nom": "titre",
   "js": "titleScreen()"
  },
  {
   "nom": "plateau",
   "js": "closeM();setTab('plateau');fitView()"
  },
  {
   "nom": "guerre",
   "js": "catSheet('guerre')"
  },
  {
   "nom": "batir",
   "js": "S.gold=200;buildMenu()"
  },
  {
   "nom": "region",
   "js": "tapRegion(D.borderTargets(S).find(r=>r.owner!=='rival').i)"
  },
  {
   "nom": "bataille",
   "js": "S.army=80;const i=D.borderTargets(S)[0].i;showBattle({won:true,kind:'campagne',tgt:S.regions[i].name,region:i,ours:90,enemy:40,loss:8,tactic:'siege',stance:'retranche'})"
  },
  {
   "nom": "evenement",
   "js": "const e=D.EVENTS.find(x=>x.id==='rival_defi');S.event={id:e.id,hist:false,text:e.text(S),choices:e.choices.map(c=>({l:c.l,d:c.d}))};showEvent()"
  },
  {
   "nom": "education",
   "js": "S.gold=100;eduMenu()"
  },
  {
   "nom": "cour",
   "js": "closeM();setTab('cour')"
  },
  {
   "nom": "conseil",
   "js": "closeM();setTab('cour');scrollTo(0,document.querySelector('.council').getBoundingClientRect().top+scrollY-60)"
  },
  {
   "nom": "voisins",
   "js": "closeM();setTab('cour');scrollTo(0,document.querySelector('.nbs').getBoundingClientRect().top+scrollY-60)"
  },
  {
   "nom": "lignee",
   "js": "closeM();setTab('lignee')"
  },
  {
   "nom": "chronique",
   "js": "closeM();setTab('chronique')"
  },
  {
   "nom": "titres",
   "js": "closeM();setTab('plateau');titlesSheet()"
  },
  {
   "nom": "edifices",
   "js": "closeM();setTab('plateau');S.gold=5000;const cap=S.regions.find(r=>r.cap),o=D.myRegions(S).find(r=>!r.cap);for(const [k,r] of [['moulin',o],['marche',o],['abbaye',o],['donjon',cap],['lices',cap]]){D.playTurn(S,'construire',r.i,k);if(S.event)D.resolveEvent(S,0);}S.event=null;S.cathedral=true;render();const c=D.mapGeom(S.seed).cells[cap.i].c;view={x:c[0]-75,y:c[1]-150,w:150,h:150*844/390};applyView()"
  },
  {
   "nom": "fin",
   "js": "setTab('plateau');for(let n=0;n<200&&!S.over;n++){D.playTurn(S,'attendre');if(S.event)D.resolveEvent(S,0);}render();showEnd()"
  }
 ]
}